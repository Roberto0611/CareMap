# Copia este archivo como .env.local y rellena tus claves reales.
# NUNCA subas .env o .env.local al repositorio.

# InsForge — obtén tus claves en https://insforge.dev
VITE_INSFORGE_PROJECT_ID=tu-project-id-aqui
VITE_INSFORGE_API_KEY=tu-api-key-aqui
VITE_INSFORGE_URL=https://tu-proyecto.us-west.insforge.app

# OpenRouter — obtén tu clave en https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui
